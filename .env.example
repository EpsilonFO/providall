# providall — variables d'environnement, communes aux deux packages.
#
# Copier en `.env` (ou `.env.local`, qui prime) et ne renseigner QUE ce dont on
# a besoin. Avec une seule clé `*_API_KEY` posée, même `LLM_MODEL` est
# facultatif : la lib prend le modèle par défaut de ce fournisseur.

# --- Le seul levier obligatoire (et encore) ---------------------------------

# Alias du registre (`providall models` les liste), ou `provider:identifiant`
# pour un modèle qui vient de sortir et n'y figure pas encore.
#   LLM_MODEL=sonnet
#   LLM_MODEL=ds-flash
#   LLM_MODEL=zai:glm-5.4-flash
#   LLM_MODEL=openrouter:z-ai/glm-4.6
LLM_MODEL=sonnet

# Modèle par rôle, utilisé quand l'appel passe `role=` / `{ role }`.
# LLM_MODEL_PLANNER=opus
# LLM_MODEL_SMALL=haiku

# --- Clés API : une par fournisseur -----------------------------------------

ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# XAI_API_KEY=
# MOONSHOT_API_KEY=
# ZAI_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=

# --- Serveur OpenAI-compatible quelconque (Ollama, vLLM, LM Studio…) --------

# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# `<PROVIDER>_BASE_URL` surcharge l'URL d'un fournisseur connu (proxy interne).
# ANTHROPIC_BASE_URL=

# --- Réglages globaux, tous surchargeables à l'appel ------------------------

# LLM_MAX_TOKENS=16000
# LLM_EFFORT=high          # none | low | medium | high | xhigh | max
# LLM_TEMPERATURE=0
# LLM_TIMEOUT=600          # secondes (TS accepte aussi LLM_TIMEOUT_MS)
# LLM_RETRIES=2

# --- Compatibilité et débogage ----------------------------------------------

# Hérité d'agenda. Seul : prend le modèle par défaut du fournisseur.
# Avec un `LLM_MODEL` nu (pas un alias du registre) : `LLM_PROVIDER:LLM_MODEL`.
# LLM_PROVIDER=openai

# Logs détaillés (corps de requête, clé masquée).
# LLM_DEBUG=1

# Coupe le chargement automatique de `.env` côté Python (les tests le posent).
# PROVIDALL_NO_DOTENV=1
